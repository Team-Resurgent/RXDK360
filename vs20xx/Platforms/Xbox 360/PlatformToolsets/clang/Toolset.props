<!--
***********************************************************************************************
RXDK-360 "clang" platform toolset - properties.

The clang toolchain: titles are built with the patched MS-PPC clang + LLVM lld
and packed by XexTool, instead of the stock XDK cl.exe/link.exe/imagexex. Selected
per project with <PlatformToolset>clang</PlatformToolset> under <Platform>RXDK-360.

This file resolves the two roots the clang build needs:
  * XDKInstallDir  - the (relocated, side-by-side) XDK, for its import libraries
                     (lib\xbox), the same resolution the stock toolset uses; and
  * RxdkClangRoot - the clang toolchain payload (clang/lld/XexTool + the C/C++
                     runtime archives and headers). Every tool/dir below derives
                     from it and is individually overridable, so the dev tree and
                     an installed layout differ only in these property values.

WARNING:  DO NOT MODIFY unless you understand MSBuild; a bad edit here breaks
          loading/building RXDK-360 projects.
***********************************************************************************************
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(VCTargetsPath)\Platforms\Xbox 360\ImportBefore\*.clang.props" Condition="Exists('$(VCTargetsPath)\Platforms\Xbox 360\ImportBefore')" />
  <Import Project="$(VCTargetsPath)\Platforms\Xbox 360\Rxdk.InstallLayout.props" />

  <PropertyGroup>
    <!-- Relocated XDK at {app} (include, lib, bin). Same resolution as 2010-01. -->

    <!-- The clang toolchain bundle root. The installed tree mirrors the real XDK:
         the bundle is a self-contained compiler at {app}\bin\clang (its own
         bin\include\lib, like the XDK's TechPreview\Jul12Compiler), NOT a {app}\modern
         sidecar. Env RXDK360_CLANG wins (dev tree); then registry ClangRoot (set to
         {app}\bin\clang by the installer); else {app}\bin\clang. -->
    <RxdkClangRoot Condition="'$(RxdkClangRoot)' == '' and '$(RXDK360_CLANG)' != ''">$(RXDK360_CLANG)</RxdkClangRoot>
    <RxdkClangRoot Condition="'$(RxdkClangRoot)' == ''">$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\TeamResurgent\RXDK-360@ClangRoot)</RxdkClangRoot>
    <RxdkClangRoot Condition="'$(RxdkClangRoot)' == ''">$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\TeamResurgent\RXDK-360@ClangRoot)</RxdkClangRoot>
    <RxdkClangRoot Condition="'$(RxdkClangRoot)' == '' and '$(RxdkInstallDir)' != '' and Exists('$(RxdkInstallDir)bin\clang\bin\clang.exe')">$(RxdkInstallDir)bin\clang</RxdkClangRoot>
    <RxdkClangRoot Condition="'$(RxdkClangRoot)' == ''">$(XDKInstallDir)</RxdkClangRoot>
    <RxdkClangRoot Condition="'$(RxdkClangRoot)' != '' and HasTrailingSlash('$(RxdkClangRoot)')">$(RxdkClangRoot.TrimEnd('\'))</RxdkClangRoot>

    <!-- Two supported layouts, detected by whether the clean installed bundle exists:
         INSTALLED (clean)  RxdkClangRoot\{bin,include,lib} = {app}\bin\clang\...  (the
                            compiler bundle), and the XDK content + our archives at the
                            product root: {app}\include\xbox and {app}\lib\xbox.
         DEV (source tree)  RxdkClangRoot\{build\llvm\bin, build\libc, build\coff,
                            vendor\..., runtime\config} + the XDK install for headers.
         Everything is overridable. -->
    <_RxdkClean Condition="'$(_RxdkClean)' == '' and Exists('$(RxdkClangRoot)\bin\clang.exe')">true</_RxdkClean>

    <!-- In the clean install the XDK headers (include\xbox), the XDK import .libs and
         our generated archives (all in lib\xbox) live at the product root, one level
         above the clang bundle (bin\clang). Prefer the registry InstallPath; fall back
         to the bundle's grandparent (bin\clang\.. \.. = {app}). -->
    <_RxdkXdkRoot Condition="'$(_RxdkXdkRoot)' == '' and '$(_RxdkClean)' == 'true' and '$(RxdkInstallDir)' != ''">$(RxdkInstallDir.TrimEnd('\'))</_RxdkXdkRoot>
    <_RxdkXdkRoot Condition="'$(_RxdkXdkRoot)' == '' and '$(_RxdkClean)' == 'true'">$([System.IO.Path]::GetFullPath('$(RxdkClangRoot)\..\..'))</_RxdkXdkRoot>

    <!-- binary tools -->
    <RxdkClangPath   Condition="'$(RxdkClangPath)'   == '' and '$(_RxdkClean)' == 'true'">$(RxdkClangRoot)\bin\clang.exe</RxdkClangPath>
    <RxdkClangPath   Condition="'$(RxdkClangPath)'   == ''">$(RxdkClangRoot)\build\llvm\bin\clang.exe</RxdkClangPath>
    <RxdkLldPath     Condition="'$(RxdkLldPath)'     == '' and '$(_RxdkClean)' == 'true'">$(RxdkClangRoot)\bin\ld.lld.exe</RxdkLldPath>
    <RxdkLldPath     Condition="'$(RxdkLldPath)'     == ''">$(RxdkClangRoot)\build\llvm\bin\ld.lld.exe</RxdkLldPath>
    <RxdkArPath      Condition="'$(RxdkArPath)'      == '' and '$(_RxdkClean)' == 'true'">$(RxdkClangRoot)\bin\llvm-ar.exe</RxdkArPath>
    <RxdkArPath      Condition="'$(RxdkArPath)'      == ''">$(RxdkClangRoot)\build\llvm\bin\llvm-ar.exe</RxdkArPath>
    <RxdkXexToolPath Condition="'$(RxdkXexToolPath)' == '' and '$(_RxdkClean)' == 'true'">$(RxdkClangRoot)\bin\XexTool.exe</RxdkXexToolPath>
    <RxdkXexToolPath Condition="'$(RxdkXexToolPath)' == '' and Exists('$(RxdkClangRoot)\build\xextool\XexTool.exe')">$(RxdkClangRoot)\build\xextool\XexTool.exe</RxdkXexToolPath>
    <RxdkXexToolPath Condition="'$(RxdkXexToolPath)' == ''">$(RxdkClangRoot)\vendor\xextool\build\Release\XexTool.exe</RxdkXexToolPath>

    <!-- library dirs: the clean layout mirrors the XDK, so every archive (our
         libc/libcpp, the coff2elf ELF libs, kernel_import/libcompat, and the XDK
         import .libs for genstubs) lives together under {app}\lib\xbox next to the
         stock console .libs (they coexist - ours are .a, the XDK's are .lib). -->
    <RxdkLibcDir Condition="'$(RxdkLibcDir)' == '' and '$(_RxdkClean)' == 'true'">$(_RxdkXdkRoot)\lib\xbox</RxdkLibcDir>
    <RxdkLibcDir Condition="'$(RxdkLibcDir)' == ''">$(RxdkClangRoot)\build\libc</RxdkLibcDir>
    <RxdkCoffDir Condition="'$(RxdkCoffDir)' == '' and '$(_RxdkClean)' == 'true'">$(_RxdkXdkRoot)\lib\xbox</RxdkCoffDir>
    <RxdkCoffDir Condition="'$(RxdkCoffDir)' == ''">$(RxdkClangRoot)\build\coff</RxdkCoffDir>

    <!-- modern C/C++23 runtime include dirs (picolibc + libc++), passed to the
         compile task explicitly so the clean and dev layouts both work. -->
    <RxdkPicolibcInc  Condition="'$(RxdkPicolibcInc)'  == '' and '$(_RxdkClean)' == 'true'">$(RxdkClangRoot)\include\picolibc</RxdkPicolibcInc>
    <RxdkPicolibcInc  Condition="'$(RxdkPicolibcInc)'  == ''">$(RxdkClangRoot)\vendor\picolibc\libc\include</RxdkPicolibcInc>
    <RxdkConfigInc    Condition="'$(RxdkConfigInc)'    == '' and '$(_RxdkClean)' == 'true'">$(RxdkClangRoot)\include\config</RxdkConfigInc>
    <RxdkConfigInc    Condition="'$(RxdkConfigInc)'    == ''">$(RxdkClangRoot)\runtime\config</RxdkConfigInc>
    <RxdkLibcxxInc    Condition="'$(RxdkLibcxxInc)'    == '' and '$(_RxdkClean)' == 'true'">$(RxdkClangRoot)\include\libcxx</RxdkLibcxxInc>
    <RxdkLibcxxInc    Condition="'$(RxdkLibcxxInc)'    == '' and Exists('$(RxdkClangRoot)\build\llvm\libcxx\include')">$(RxdkClangRoot)\build\llvm\libcxx\include</RxdkLibcxxInc>
    <RxdkLibcxxInc    Condition="'$(RxdkLibcxxInc)'    == ''">$(RxdkClangRoot)\vendor\llvm-project\libcxx\include</RxdkLibcxxInc>
    <RxdkLibcxxabiInc Condition="'$(RxdkLibcxxabiInc)' == '' and '$(_RxdkClean)' == 'true'">$(RxdkClangRoot)\include\libcxxabi</RxdkLibcxxabiInc>
    <RxdkLibcxxabiInc Condition="'$(RxdkLibcxxabiInc)' == '' and Exists('$(RxdkClangRoot)\build\llvm\libcxxabi\include')">$(RxdkClangRoot)\build\llvm\libcxxabi\include</RxdkLibcxxabiInc>
    <RxdkLibcxxabiInc Condition="'$(RxdkLibcxxabiInc)' == ''">$(RxdkClangRoot)\vendor\llvm-project\libcxxabi\include</RxdkLibcxxabiInc>

    <!-- XDK headers (for XDK-headers mode) + import .libs (for genstubs). The clean
         install keeps a single copy of the XDK tree at the product root (mirroring the
         real XDK: {app}\include\xbox, {app}\lib\xbox) - no staged duplicate under the
         compiler bundle. -->
    <RxdkXdkIncludeDir Condition="'$(RxdkXdkIncludeDir)' == '' and '$(_RxdkClean)' == 'true'">$(_RxdkXdkRoot)\include\xbox</RxdkXdkIncludeDir>
    <RxdkXdkIncludeDir Condition="'$(RxdkXdkIncludeDir)' == ''">$(XDKInstallDir)include\xbox</RxdkXdkIncludeDir>
    <RxdkXdkLibDir Condition="'$(RxdkXdkLibDir)' == '' and '$(_RxdkClean)' == 'true'">$(_RxdkXdkRoot)\lib\xbox</RxdkXdkLibDir>
    <RxdkXdkLibDir Condition="'$(RxdkXdkLibDir)' == ''">$(RxdkXboxLibDir)</RxdkXdkLibDir>

    <!-- IntelliSense include search order (this is IntelliSense-only: the
         ClangCompile task builds its own -I list from the Rxdk*Inc properties and
         ignores $(IncludePath)).

         XDK-headers mode: the stock XDK headers #include <math.h>/<stdlib.h> at file
         scope (e.g. d3dx9.h), and the IntelliSense parser runs in MSVC mode (no
         __clang__ predefined). libc++'s C wrappers open 'namespace std {' through
         macros that DON'T balance under that parser - so if libc++ is searched first
         for <math.h>, everything the XDK header declares afterwards (D3DXMATRIX, the
         D3DXMatrix* functions, ...) is parsed into std::__1 and reads as "undefined"
         at global scope. Put the plain C headers (picolibc/config) and the XDK
         headers AHEAD of libc++ so the C includes resolve to real C headers; libc++
         stays on the path (last) so <vector>/<string>/... still resolve for std::.

         Pure-clang mode (no XDK headers): keep libc++ first, the normal layering. -->
    <IncludePath Condition="'$(IncludePath)' == '' and '$(RxdkClangXdkHeaders)' == 'true'">$(RxdkConfigInc);$(RxdkPicolibcInc);$(RxdkXdkIncludeDir);$(RxdkLibcxxInc);$(RxdkLibcxxabiInc);</IncludePath>
    <IncludePath Condition="'$(IncludePath)' == ''">$(RxdkLibcxxInc);$(RxdkLibcxxabiInc);$(RxdkConfigInc);$(RxdkPicolibcInc);$(RxdkXdkIncludeDir);</IncludePath>
    <LibraryPath Condition="'$(LibraryPath)' == ''">$(RxdkLibcDir);$(RxdkCoffDir);</LibraryPath>
    <!-- $(RxdkBinDir) ({app}\bin\win32) carries the stock XDK content compilers
         (xuipkg, xactbld3, fxc, resx2bin, ...) that samples drive from VC custom
         build steps. The 2010-01 toolset already lists it on ExecutablePath; the
         clang toolset omitted it, so those steps failed with 9009 "not recognized"
         unless the SDK bin happened to be on the system PATH. -->
    <ExecutablePath Condition="'$(ExecutablePath)' == ''">$([System.IO.Path]::GetDirectoryName('$(RxdkClangPath)'));$(RxdkBinDir);$(PATH);</ExecutablePath>
    <!-- Surfaced read-only on the General property page (general.xml ->
         RxdkToolchainDisplay) so it is obvious at a glance which toolchain a
         project builds with. The stock 2010-01 toolset sets "Stock XDK". -->
    <RxdkToolchain Condition="'$(RxdkToolchain)' == ''">Clang/LLVM</RxdkToolchain>
  </PropertyGroup>

  <!-- IntelliSense parity with the real compile. The C++ language service never
       runs the ClangCompile task, so it only sees $(IncludePath) plus the ClCompile
       item metadata below - it does NOT see the -include files and -D defines the
       task puts on the actual clang command line. Give it the same ones here (the
       task builds its own command line, so these are inert for the real build):

         * Force-include the libc++ site config + prereqs. Without __config_site,
           libc++'s <__config> never establishes _LIBCPP_ABI_NAMESPACE, so its
           'namespace std {' opens unbalanced and swallows every *global* XDK
           declaration (D3DX*, ...) into std::__1 - which is why calls at file
           scope light up as E0020 "identifier undefined" while the build is clean.
         * Define _GNU_SOURCE/__Picolibc__ so the libc headers match, and (XDK-
           headers mode) the Win32/Xbox gates + _XM_NO_INTRINSICS_ so xnamath/
           xboxmath parse in scalar mode instead of tripping on __vector4 VMX128
           intrinsics the IntelliSense parser doesn't know.

       These files resolve on $(IncludePath) (all three live in the config dir).
       This mirrors AutoClangFlags()/XdkHeaderFlags() in ClangCompile.cs - keep the
       two in sync. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <ForcedIncludeFiles>__config_site;rxdk_libcpp_prereq.h;picolibc.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <PreprocessorDefinitions>__Picolibc__;_GNU_SOURCE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(RxdkClangXdkHeaders)' == 'true'">
    <ClCompile>
      <!-- _M_PPC / _M_PPCBE / _XBOX_VER / __VMX128_SUPPORTED are supplied for
           IntelliSense by the stock xbox_intellisense_platform.h shim (force-included
           via Microsoft.Cl.Xbox 360.props under __INTELLISENSE__); don't redefine
           them here or they clash. These are the remaining gates the shim omits. -->
      <PreprocessorDefinitions>_WIN32=1;_XBOX=1;__export=;_SIZE_T_DEFINED;_XM_NO_INTRINSICS_;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <Import Project="$(VCTargetsPath)\Platforms\Xbox 360\ImportAfter\*.clang.props" Condition="Exists('$(VCTargetsPath)\Platforms\Xbox 360\ImportAfter')" />
</Project>
